<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sky gradient: blue up top fading to warm orange near the horizon -->
    <item android:top="0dp" android:bottom="260dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#4FC3E8"
                android:endColor="#FFD98A"
                android:angle="270" />
        </shape>
    </item>

    <!-- Sun -->
    <item
        android:top="24dp"
        android:right="28dp"
        android:width="64dp"
        android:height="64dp"
        android:gravity="top|right">
        <shape android:shape="oval">
            <solid android:color="#FFEB6B" />
        </shape>
    </item>

    <!-- Cloud (simple layered ovals) -->
    <item
        android:top="40dp"
        android:left="24dp"
        android:width="60dp"
        android:height="26dp"
        android:gravity="top|left">
        <shape android:shape="oval">
            <solid android:color="#CCFFFFFF" />
        </shape>
    </item>

    <!-- Sea band -->
    <item android:top="230dp" android:bottom="140dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1AAFC9"
                android:endColor="#0E8FAE"
                android:angle="270" />
        </shape>
    </item>

    <!-- Sand -->
    <item android:top="330dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#F4D9A0" />
        </shape>
    </item>

    <!-- Waterline edge -->
    <item android:top="330dp" android:bottom="318dp">
        <shape android:shape="rectangle">
            <solid android:color="#E0B579" />
        </shape>
    </item>

</layer-list>