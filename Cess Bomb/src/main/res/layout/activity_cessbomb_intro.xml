<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cessbomb_bg_sand">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/textCessBombTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cessbomb_title"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/cessbomb_text_dark"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cessbomb_intro_instructions"
            android:textSize="16sp"
            android:textColor="@color/cessbomb_text_dark"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textBestScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/cessbomb_text_dark"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cessbomb_choose_difficulty"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/cessbomb_text_dark"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/difficultyRadioGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/radioEasy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cessbomb_difficulty_easy" />

            <RadioButton
                android:id="@+id/radioNormal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cessbomb_difficulty_normal"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioHard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cessbomb_difficulty_hard" />
        </RadioGroup>

        <Button
            android:id="@+id/playButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cessbomb_play_button"
            android:textColor="@android:color/white"
            android:background="@drawable/cessbomb_button_bg"
            android:padding="16dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/backToPartyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cessbomb_back_to_party"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            android:textColor="@color/cessbomb_text_dark" />

    </LinearLayout>
</ScrollView>
