<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#121212">

    <!-- Row 1: Snake & Pig -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <Button
            android:id="@+id/btnSnake"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:background="@drawable/snakeandapplegamelogo"
            app:backgroundTint="@null"
            android:layout_marginEnd="20dp" />

        <Button
            android:id="@+id/btnPig"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:text="Catch\nThat\nPig"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 2: Go Ski & Cess Bomb -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <Button
            android:id="@+id/btnGoSki"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:text="Go Ski"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginEnd="20dp" />

        <Button
            android:id="@+id/btnCessBomb"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:text="Cess\nBomb"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Row 3: Matching Game (Centered at the bottom) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnMatching"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:text="Matching\nGame"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>