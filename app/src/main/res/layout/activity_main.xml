<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#121212">

    <!-- === NEW ARCADE HEADER === -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="40dp">

        <!-- Main Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SUMMERTIME PARTY"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <!-- Neon Subtitle with LED Glow Effect -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5-IN-1 ARCADE COLLECTION"
            android:textColor="#00E676"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:layout_marginTop="8dp"
            android:shadowColor="#00E676"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="15"/>
    </LinearLayout>
    <!-- ========================= -->

    <!-- Row 1: Snake & Pig -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <Button
            android:id="@+id/btnSnake"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:background="@drawable/snakeandapplegamelogo"
            app:backgroundTint="@null"
            android:layout_marginEnd="20dp" />

        <Button
            android:id="@+id/btnPig"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:background="@drawable/catchpigslogo"
            app:backgroundTint="@null" />
    </LinearLayout>

    <!-- Row 2: Go Ski & Cess Bomb -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <Button
            android:id="@+id/btnGoSki"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/go_ski_logo"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnCessBomb"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:background="@drawable/logo_game"
            app:backgroundTint="@null" />
    </LinearLayout>

    <!-- Row 3: Matching Game (Centered at the bottom) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnMatching"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:background="@drawable/matchinggame"
            app:backgroundTint="@null" />
    </LinearLayout>

</LinearLayout>